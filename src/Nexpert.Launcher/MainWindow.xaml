<Window x:Class="Nexpert.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXPERT" Height="760" Width="1240" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="#0B0D0F" Foreground="#F3F1EB"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121619"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#1A2022"/>
        <SolidColorBrush x:Key="Muted" Color="#89918E"/>
        <SolidColorBrush x:Key="Accent" Color="#D7FF64"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#0B0D0F"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F3F1EB"/><Setter Property="Background" Value="#202729"/>
            <Setter Property="BorderBrush" Value="#343C3D"/><Setter Property="Padding" Value="12,10"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#101416" BorderBrush="#202627" BorderThickness="0,0,1,0">
            <DockPanel Margin="22,26,18,20">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,46">
                        <Border Width="30" Height="30" Background="#D7FF64" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="N" Foreground="#0B0D0F" FontWeight="Black" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="NEXPERT" FontWeight="Bold" FontSize="15"/><TextBlock Text="RUST CLIENT" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="LIBRARY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="8,0,0,12"/>
                    <Border Background="#202729" CornerRadius="7" Padding="11,10" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="{StaticResource Accent}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="My game" FontWeight="SemiBold"/></StackPanel></Border>
                    <StackPanel Orientation="Horizontal" Margin="11,9,0,6"><TextBlock Text="◈" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Text="Resource packs" Foreground="#AAB1AE"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="11,9,0,0"><TextBlock Text="⚙" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Text="Settings" Foreground="#AAB1AE"/></StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#252B2D" Margin="0,0,0,16"/>
                    <TextBlock Text="EARLY ACCESS · 0.1.0" Foreground="{StaticResource Muted}" FontSize="9"/>
                    <TextBlock Text="Your game files stay on this PC." Foreground="#646D6A" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="38,28,38,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,27">
                <StackPanel><TextBlock Text="GAME LIBRARY  /  OVERVIEW" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Ready when you are." FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#171D1F" BorderBrush="#2A3233" BorderThickness="1" CornerRadius="18" Padding="11,7"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#D7FF64" Margin="0,0,8,0"/><TextBlock Text="LOCAL MODE" FontSize="9" FontWeight="Bold" Foreground="#CBD2CF"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#151B1D" BorderBrush="#263031" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#243833" Offset="0"/><GradientStop Color="#172221" Offset="0.58"/><GradientStop Color="#111719" Offset="1"/></LinearGradientBrush></Grid.Background>
                            <Canvas Opacity="0.65">
                                <Rectangle Width="115" Height="115" Fill="#334D3E" Canvas.Left="80" Canvas.Top="160"/><Rectangle Width="115" Height="115" Fill="#263B33" Canvas.Left="195" Canvas.Top="160"/><Rectangle Width="115" Height="115" Fill="#3B5945" Canvas.Left="310" Canvas.Top="160"/><Rectangle Width="115" Height="115" Fill="#2D4637" Canvas.Left="425" Canvas.Top="160"/>
                                <Rectangle Width="115" Height="115" Fill="#26392F" Canvas.Left="137" Canvas.Top="275"/><Rectangle Width="115" Height="115" Fill="#38523E" Canvas.Left="252" Canvas.Top="275"/><Rectangle Width="115" Height="115" Fill="#273B32" Canvas.Left="367" Canvas.Top="275"/>
                                <Rectangle Width="115" Height="115" Fill="#1B2824" Canvas.Left="195" Canvas.Top="390"/><Rectangle Width="115" Height="115" Fill="#304A38" Canvas.Left="310" Canvas.Top="390"/>
                            </Canvas>
                            <Rectangle Fill="#80101416"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="30,30,30,28"><TextBlock Text="YOUR NEXT WORLD" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Built for smooth play." FontSize="32" FontWeight="SemiBold" Margin="0,9,0,5"/><TextBlock Text="Choose a local game version to prepare your client." Foreground="#B4BEBA" FontSize="13"/></StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" Background="#75101416" CornerRadius="6" Padding="10,7"><TextBlock Text="RUST · CLIENT PREVIEW" FontSize="9" Foreground="#D7DEDA" FontWeight="Bold"/></Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="#273031" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="SELECTED VERSION" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><ComboBox x:Name="VersionPicker" Width="230" HorizontalAlignment="Left" Margin="0,9,0,0" SelectionChanged="VersionPicker_SelectionChanged"/></StackPanel>
                            <Button x:Name="PlayButton" Grid.Column="1" Content="▶   LAUNCH PREVIEW" VerticalAlignment="Bottom" Click="PlayButton_Click" IsEnabled="False"/>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource Panel}" BorderBrush="#273031" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,16"><TextBlock Text="GAME FILES" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="InstallStatus" Text="NOT CONNECTED" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/></Grid>
                            <TextBlock Text="Installation folder" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GameRootBox" Background="#0D1112" Foreground="#DDE3DF" BorderBrush="#303839" Padding="10,9" FontSize="11" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="CHOOSE" Padding="12,9" Background="#283133" Foreground="#E3E8E4" FontSize="10" Click="ChooseFolder_Click"/></Grid>
                            <TextBlock x:Name="GameHint" Text="Select your local Minecraft game folder." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" BorderBrush="#273031" BorderThickness="1" CornerRadius="12" Padding="18" MinHeight="190">
                        <StackPanel>
                            <Grid Margin="0,0,0,14"><TextBlock Text="RESOURCE PACKS" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="PackCount" Text="0 FOUND" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/></Grid>
                            <TextBlock x:Name="PackHint" Text="Resource packs in the selected installation will appear here." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="PackList" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#1B2224" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock Text="{Binding}" FontSize="11" Foreground="#DEE4E0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" BorderBrush="#273031" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="70" Height="70" Background="#202729" CornerRadius="8" ClipToBounds="True"><Image x:Name="TexturePreview" Stretch="Fill"/></Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="VANILLA TEXTURE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="TextureInfo" Text="Choose a version to preview its Minecraft texture." Foreground="#DDE3DF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="#151A1C" CornerRadius="10" Padding="15" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" Foreground="{StaticResource Accent}" FontSize="15" Margin="0,0,10,0"/><TextBlock Text="Game files are loaded locally and never bundled." Foreground="#AAB3AF" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel></Border>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="2" Text="NEXPERT IS AN UNOFFICIAL COMMUNITY PROJECT · MINECRAFT IS A TRADEMARK OF MOJANG AB" Foreground="#626B68" FontSize="9" Margin="0,20,0,0"/>
        </Grid>
    </Grid>
</Window>
